# Copy this file to .env: cp .env.example .env
# Rules and defaults for each setting: src/platform/config/env.schema.ts

NODE_ENV=development
PORT=3000
# postgres://user:password@host:port/database, matching the database in docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mock_interview
# Comma-separated websites allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173
